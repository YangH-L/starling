# 构建信息（spec §13.4，裁定 R88）：每次构建都跑（starling_build_info 目标，ALL），取 `git -C <源码目录> rev-parse HEAD`
# 写进 <构建目录>/generated/starling/build_commit.inc。内容不变就不重写（copy_if_different），
# 依赖它的 build_info.cpp 不会每次重编。不在 git 仓库里、或没有 git 时写 "unknown"。
#
# 用法：cmake -DSTARLING_SOURCE_DIR=<dir> -DSTARLING_BUILD_INFO_OUT=<file> [-DGIT_EXECUTABLE=<git>] -P StarlingBuildInfo.cmake
set(_commit "unknown")
if(GIT_EXECUTABLE)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" -C "${STARLING_SOURCE_DIR}" rev-parse HEAD
        OUTPUT_VARIABLE _git_out
        ERROR_QUIET
        RESULT_VARIABLE _git_rc
        OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(_git_rc EQUAL 0 AND _git_out MATCHES "^[0-9a-f]+$")
        string(LENGTH "${_git_out}" _len)
        if(_len EQUAL 40)
            set(_commit "${_git_out}")
        endif()
    endif()
endif()
set(_content "// Auto-generated by cmake/StarlingBuildInfo.cmake. Do not edit.\n\"${_commit}\"\n")
set(_tmp "${STARLING_BUILD_INFO_OUT}.tmp")
file(WRITE "${_tmp}" "${_content}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${_tmp}" "${STARLING_BUILD_INFO_OUT}")
file(REMOVE "${_tmp}")
